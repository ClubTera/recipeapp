# ── Supabase（Project Settings → API から取得） ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Web Push（`npm run gen:vapid` で一度だけ生成し、以後変更しない） ──────
# 公開鍵はクライアントの pushManager.subscribe() で使う
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 以下は Next.js 側では使わない。Supabase Edge Function の Secrets に登録する:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
#   （SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY は Edge Function に自動注入される）

# ── アプリのURL（通知のリンク生成などに使用） ────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
